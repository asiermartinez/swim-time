BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//swim-time//swimtime//ES
CALSCALE:GREGORIAN
METHOD:PUBLISH
X-WR-CALNAME:Piscina C.C. Judimendi
X-WR-CALDESC:Horas más tranquilas de C.C. Judimendi\, según la ocupación
  típica de cada día de la semana.
X-WR-TIMEZONE:Europe/Madrid
REFRESH-INTERVAL;VALUE=DURATION:PT6H
X-PUBLISHED-TTL:PT6H
BEGIN:VTIMEZONE
TZID:Europe/Madrid
BEGIN:DAYLIGHT
TZOFFSETFROM:+0100
DTSTART:19810329T020000
RRULE:FREQ=YEARLY;BYMONTH=3;BYDAY=-1SU
TZNAME:CEST
TZOFFSETTO:+0200
END:DAYLIGHT
BEGIN:STANDARD
TZOFFSETFROM:+0200
DTSTART:19961027T030000
RRULE:FREQ=YEARLY;BYMONTH=10;BYDAY=-1SU
TZNAME:CET
TZOFFSETTO:+0100
END:STANDARD
END:VTIMEZONE
END:VCALENDAR
